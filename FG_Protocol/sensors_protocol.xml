<?xml version="1.0"?>
<PropertyList>
<generic>
   <output>
       <line_separator>newline</line_separator>
       <var_separator>tab</var_separator>

       <!-- Position -->
       <chunk>
          <node>/position/latitude-deg</node>
          <name>latitude-deg</name>
          <type>double</type>
          <format>%03.13f</format>
        </chunk>

       <chunk>
          <node>/position/longitude-deg</node>
          <name>longitude-deg</name>
          <type>double</type>
          <format>%03.13f</format>
        </chunk>

        <chunk>
          <node>/position/altitude-ft</node>
          <name>altitude-ft</name>
          <type>double</type>
          <format>%03.13f</format>
        </chunk>

        <!-- Angles & Rates -->
        <chunk>
          <node>/orientation/track-deg</node>
          <name>track-deg</name>
          <type>double</type>
          <format>%03.13f</format>
        </chunk>

        <chunk>
          <node>/orientation/pitch-deg</node>
          <name>pitch-deg</name>
          <type>double</type>
          <format>%03.13f</format>
        </chunk>

        <chunk>
          <node>/orientation/roll-deg</node>
          <name>roll-deg</name>
          <type>double</type>
          <format>%03.13f</format>
        </chunk>

        <chunk>
          <node>/orientation/true-heading-deg</node>
          <name>heading-deg</name>
          <type>double</type>
          <format>%03.13f</format>
        </chunk>

        <chunk>
          <node>/orientation/pitch-rate-degps</node>
          <name>pitch-rate-degps</name>
          <type>double</type>
          <format>%03.13f</format>
        </chunk>

        <chunk>
          <node>/orientation/roll-rate-degps</node>
          <name>roll-rate-degps</name>
          <type>double</type>
          <format>%03.13f</format>
        </chunk>

        <chunk>
          <node>/orientation/yaw-rate-degps</node>
          <name>yaw-rate-degps</name>
          <type>double</type>
          <format>%03.13f</format>
        </chunk>

        <!-- Speeds -->
        <chunk>
          <node>/velocities/airspeed-kt</node>
          <name>airspeed-kt</name>
          <type>double</type>
          <format>%03.13f</format>
        </chunk>

        <chunk>
          <node>/velocities/groundspeed-kt</node>
          <name>groundspeed-kt</name>
          <type>double</type>
          <format>%03.13f</format>
        </chunk>

   </output>
 </generic>
</PropertyList>